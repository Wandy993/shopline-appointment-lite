NODE_ENV=development
PORT=3000
APP_URL=http://localhost:3000
MONGODB_URI=mongodb://127.0.0.1:27017/appointment-lite

# SHOPLINE Developer Center credentials
SHOPLINE_APP_KEY=
SHOPLINE_APP_SECRET=
SHOPLINE_SCOPES=read_products,read_store_information
SHOPLINE_API_VERSION=v20260301
SHOPLINE_CALLBACK_PATH=/auth/callback

# Use a long random value (for example: openssl rand -hex 32)
SESSION_SECRET=replace-with-a-long-random-string
COOKIE_SAME_SITE=lax

# Comma-separated storefront origins. Empty allows all origins for initial setup.
# Example: https://demo.myshopline.com,https://www.example.com
PUBLIC_ALLOWED_ORIGINS=

# Optional email delivery. Bookings still work when these are empty.
RESEND_API_KEY=
EMAIL_FROM=Appointment Lite <bookings@example.com>
MERCHANT_NOTIFICATION_EMAIL=

# Reserved plan override for development: free | pro
DEFAULT_PLAN=free
LOG_LEVEL=info
