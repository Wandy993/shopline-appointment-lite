NODE_ENV=development
PORT=3000
APP_URL=http://localhost:3000
MONGODB_URI=mongodb://127.0.0.1:27017/appointment-lite
MONGODB_DB_NAME=shopline_appointment_lite

# SHOPLINE Developer Center credentials
SHOPLINE_APP_KEY=
SHOPLINE_APP_SECRET=
SHOPLINE_SCOPES=read_products,read_store_information,read_content,read_orders,read_location
SHOPLINE_API_VERSION=v20260301
SHOPLINE_CALLBACK_PATH=/auth/callback
# Copy EXTENSION_UUID from the CLI-created Theme App Extension .env file.
SHOPLINE_THEME_EXTENSION_UUID=
SHOPLINE_THEME_BLOCK_HANDLE=appointment-lite

# SHOPLINE application subscription (v0.7.0)
# Appointment Lite has one paid plan: Appointment Lite Pro at USD 5.99/month.
# The 7-day free trial is configured and enforced in SHOPLINE Partner Center.
# Keep disabled until the plan, Partner Token, and subscription webhooks are ready.
SHOPLINE_SUBSCRIPTION_ENABLED=false
SHOPLINE_PARTNER_TOKEN=
SHOPLINE_PARTNER_API_VERSION=v20220901
SHOPLINE_SUBSCRIPTION_SPU_KEY=appointment_lite_pro
SHOPLINE_SUBSCRIPTION_PLAN_NAME=Appointment Lite Pro
SHOPLINE_SUBSCRIPTION_PRICE_USD=5.99
SHOPLINE_SUBSCRIPTION_TRIAL_DAYS=7
SHOPLINE_SUBSCRIPTION_GRACE_HOURS=24
SHOPLINE_SUBSCRIPTION_SYNC_MAX_AGE_SECONDS=120
SHOPLINE_SUBSCRIPTION_TIMEOUT_MS=15000

# Use a long random value (for example: openssl rand -hex 32)
SESSION_SECRET=replace-with-a-long-random-string
COOKIE_SAME_SITE=lax

# Comma-separated storefront origins. Empty allows all origins for initial setup.
# Example: https://demo.myshopline.com,https://www.example.com
PUBLIC_ALLOWED_ORIGINS=

# Optional email delivery. Bookings still work when these are empty.
# auto prefers Aliyun DirectMail when fully configured, then Resend.
EMAIL_PROVIDER=auto

# Recommended for Railway: Aliyun DirectMail HTTPS OpenAPI using a least-privilege RAM user.
# Minimum policy action: dm:SingleSendMail
ALIBABA_CLOUD_ACCESS_KEY_ID=
ALIBABA_CLOUD_ACCESS_KEY_SECRET=
# Optional only when using temporary STS credentials.
ALIBABA_CLOUD_SECURITY_TOKEN=
ALIYUN_DIRECTMAIL_ACCOUNT_NAME=
ALIYUN_DIRECTMAIL_FROM_ALIAS=Appointment Lite
ALIYUN_DIRECTMAIL_REPLY_TO=true
ALIYUN_DIRECTMAIL_ENDPOINT=dm.aliyuncs.com
ALIYUN_DIRECTMAIL_REGION_ID=cn-hangzhou
ALIYUN_DIRECTMAIL_TAG_NAME=

# Optional fallback provider.
RESEND_API_KEY=
EMAIL_FROM=Appointment Lite <bookings@example.com>
MERCHANT_NOTIFICATION_EMAIL=

LOG_LEVEL=info

# Google Calendar OAuth + appointment event sync.
# Google Auth Platform production branding (v0.6.13):
#   Homepage: https://appointment.toolkit.fans/
#   Privacy: https://appointment.toolkit.fans/en/privacy
#   Terms: https://appointment.toolkit.fans/en/terms
#   Authorized domain: toolkit.fans
# Create a Google Cloud OAuth 2.0 Web application and enable Google Calendar API.
GOOGLE_CALENDAR_CLIENT_ID=
GOOGLE_CALENDAR_CLIENT_SECRET=
# Must exactly match the authorized redirect URI in Google Cloud.
GOOGLE_CALENDAR_REDIRECT_URI=https://appointment.toolkit.fans/integrations/google/callback
# Generate once with: openssl rand -hex 32
GOOGLE_TOKEN_ENCRYPTION_KEY=

# Public homepage / Privacy / Terms / FAQ contact information (v0.6.13).
# These pages work without these values; set them before App Store submission
# to show your legal operator name and direct support email.
LEGAL_OPERATOR_NAME=Appointment Lite
LEGAL_SUPPORT_EMAIL=


# Toolkit Ops Hub observability (v0.6.16).
# Keep disabled until Appointment Lite is registered in Toolkit Ops Hub and a
# unique ingest secret has been issued for this app. Never reuse another app's secret.
OPS_HUB_ENABLED=false
OPS_HUB_INGEST_URL=https://toolkit-ops-hub-production.up.railway.app/api/ingest/v1/events
OPS_HUB_APP_KEY=appointment-lite
OPS_HUB_INGEST_SECRET=
OPS_HUB_TIMEOUT_MS=15000
OPS_HUB_BATCH_SIZE=10
OPS_HUB_WORKER_INTERVAL_MS=10000
OPS_HUB_INITIAL_SYNC_DELAY_MS=15000
OPS_HUB_HEARTBEAT_MS=300000
OPS_HUB_ACTIVE_THROTTLE_MS=86400000
OPS_HUB_HEALTH_DEDUPE_MS=300000
OPS_HUB_EVENT_RETENTION_DAYS=45
OPS_HUB_USAGE_RETENTION_DAYS=120
